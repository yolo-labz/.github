  "render": {
    "resolution": [900, 900],
    "ortho_scale": 250.0,
    "ortho_scale_note": "per-view override; the 3/4 and hero cameras look at the 90-unit case corner-on, where the 2.25H case projects past a 250-unit frame. Framing only, geometry is view-independent.",
    "framing_center": [0.0, -8.0, -12.0],
    "aa": "8",
    "threads": 4,
    "seed": 1,
    "eevee_samples": 16,
    "views": [
      { "name": "front", "azimuth": 0.0, "elevation": 6.0, "pose": "rest", "produced": false },
      { "name": "three-quarter", "azimuth": 35.0, "elevation": 14.0, "pose": "rest", "produced": false, "ortho_scale": 266.0 },
      { "name": "side", "azimuth": 90.0, "elevation": 6.0, "pose": "rest", "produced": false },
      { "name": "back", "azimuth": 180.0, "elevation": 6.0, "pose": "rest", "produced": false },
      { "name": "hero", "azimuth": 32.0, "elevation": 16.0, "pose": "reach", "produced": true, "ortho_scale": 266.0 }
    ],
    "lights": [
      { "name": "key", "location": [-150.0, -240.0, 190.0], "energy": 1900000.0, "size": 170.0 },
      { "name": "fill", "location": [220.0, -170.0, 60.0], "energy": 720000.0, "size": 220.0 },
      { "name": "rim", "location": [70.0, 260.0, 150.0], "energy": 1300000.0, "size": 150.0 }
    ]
  },

  "svg": {
    "viewBox": [0, 0, 128, 128],
    "tile_radius": 26,
    "figure": { "translate": [64, 68], "scale": 0.58 },
    "compare_target": "profile/assets/brand/mascot/gremlin-avatar.svg",
    "iou_min": 0.85,
    "raster_px": 512
  },

  "renders": {
    "note": "Published hero plates for downstream consumers. Each size is rendered with the camera fitted to the character, so the frame is the artwork, not a crop of a bigger render. Themes are the two Catppuccin flavours the kit already defines; nothing here is a new colour.",
    "sizes": [[1600, 1200], [800, 600], [390, 520], [804, 770], [402, 385]],
    "themes": ["dark", "light"],
    "formats": ["png", "webp", "avif"],
    "view": {
      "azimuth": 32.0,
      "elevation": 16.0,
      "pose": "reach",
      "produced": true,
      "why": "the hero pose from model/check.py's view list: claws on the keys, mauve code marks"
    },
    "margin": 0.06,
    "quality": { "webp": 88, "avif": 60 },
    "consumer_note": "804x770 and 402x385 are the two widths the portfolio home render currently ships; 1600x1200, 800x600 and 390x520 are the generic hero set."
  },

  "checks": {
    "delta_e_max": 3.0,
    "delta_e_min_pixels": 200,
    "determinism_max_changed_fraction": 0.005
  }
}
