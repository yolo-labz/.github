{
  "schema": 1,
  "meta": {
    "character": "the programming gremlin",
    "org": "yolo-labz",
    "note": "Single source of truth for the gremlin. 2D sections use SVG hero/avatar units, [x, y] with y pointing DOWN. 3D-only sections are marked *3d and use [x, z] with z pointing UP (z = -y). 1 SVG unit == 1 Blender unit.",
    "masters": [
      "profile/assets/brand/mascot/gremlin-model-sheet.svg",
      "profile/assets/brand/mascot/gremlin-avatar.svg",
      "profile/assets/brand/mascot/gremlin-hero.svg"
    ],
    "derivation": "Every number below is lifted from the three masters above. Nothing is freehand."
  },

  "palette": {
    "base":  { "hex": "#1e1e2e", "role": "background plate", "check": true },
    "skin":  { "hex": "#a6e3a1", "role": "skin - the character, never recolour", "check": true },
    "pale":  { "hex": "#cdd6f4", "role": "teeth, eyes, claws", "check": true },
    "dark":  { "hex": "#181825", "role": "mouth interior, keyboard deck", "check": true },
    "node":  { "hex": "#cba6f7", "role": "pupils; produced output only", "check": true },
    "key":   { "hex": "#45475a", "role": "keycaps", "check": true },
    "guide": { "hex": "#6c7086", "role": "keyboard rim", "check": false }
  },

  "palette_light": {
    "base":  { "hex": "#eff1f5", "role": "background plate (Latte)", "check": false },
    "skin":  { "hex": "#40a02b", "role": "skin (Latte) - the character, never recolour", "check": false },
    "pale":  { "hex": "#eff1f5", "role": "teeth, eyes, claws (Latte, from the hero kit's light query)", "check": false },
    "dark":  { "hex": "#dce0e8", "role": "mouth interior, keyboard case (Latte)", "check": false },
    "node":  { "hex": "#8839ef", "role": "pupils; produced output only (Latte)", "check": false },
    "key":   { "hex": "#9ca0b0", "role": "keycaps (Latte)", "check": false },
    "guide": { "hex": "#9ca0b0", "role": "keyboard outline stroke (Latte)", "check": false }
  },

