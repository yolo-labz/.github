    },
    "hero2d": {
      "front_half_width": 90.0,
      "back_half_width": 78.0,
      "source": "profile/assets/brand/mascot/gremlin-hero.svg .kbd path M 42 132 L 198 132 L 210 154 L 30 154 Z (x 30..210 front, 42..198 back, head unit 80); model/check.py re-reads it"
    },
    "keys": {
      "cols": 8,
      "rows": 3,
      "width": 15.5,
      "depth": 11.0,
      "height": 2.5,
      "spacebar": { "rows_after": 1, "inset": 10.0 }
